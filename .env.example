# ─── ShipView — Variables de entorno ───────────────────────────────────────
# Copiá este archivo a ".env" para desarrollo local
# En Render.com: agregá estas variables en Environment → Add Environment Variable

# Puerto del servidor (Render lo sobreescribe automáticamente)
PORT=3000

# ── Supabase (obligatorio para producción) ───────────────────────────────────
# Obtené estos valores en: supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
